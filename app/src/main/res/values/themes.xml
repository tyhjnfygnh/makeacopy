<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Material3, compatible with Material widgets via M3 styles). -->
    <style name="Theme.MakeACopy" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- M3 container tokens used by components -->
        <item name="colorPrimaryContainer">@color/purple_200</item>
        <item name="colorOnPrimaryContainer">@color/purple_700</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Surface -->
        <item name="colorOnSurface">@color/black</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- The bottom bars sit behind the navigation bar and give it its background -->
        <item name="android:enforceNavigationBarContrast">false</item>

        <!-- (Optional) Shadow colors -->
        <item name="android:outlineSpotShadowColor">#4A7AAC</item>
        <item name="android:outlineAmbientShadowColor">#2A5A8E</item>

        <!-- Material dialogs in M3 style -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Material3.MaterialAlertDialog</item>

        <!-- Default overlay for BottomSheetDialog -->
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.MakeACopy.BottomSheet</item>

        <!-- Global MaterialButton style -->
        <item name="materialButtonStyle">@style/Widget.MakeACopy.Button</item>

        <!-- Messages follow the theme instead of inverting it -->
        <item name="snackbarStyle">@style/Widget.MakeACopy.Snackbar</item>
        <item name="snackbarTextViewStyle">@style/Widget.MakeACopy.Snackbar.TextView</item>
    </style>

    <!-- Message above the bottom bar: dark in the dark theme and light in the light theme, like
         the system toast it replaces. The Material default inverts the surface colors. -->
    <style name="Widget.MakeACopy.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">?attr/colorSurfaceContainerHighest</item>
    </style>

    <style name="Widget.MakeACopy.Snackbar.TextView" parent="Widget.Material3.Snackbar.TextView">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Bottom-sheet overlay (no dependency on com.google.android.material.R in code) -->
    <style name="ThemeOverlay.MakeACopy.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:windowIsTranslucent">false</item>
        <!-- Optional:
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.M3.Corner.Medium</item>
        -->
    </style>

    <!-- Unified MaterialButton style. Colors come from Material tokens so that
         dynamic color (Material You) and dark mode are handled automatically. -->
    <style name="Widget.MakeACopy.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Secondary (tonal) button style for non-primary actions in bottom bars -->
    <style name="Widget.MakeACopy.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Optional: special outlined button style -->
    <style name="Widget.MakeACopy.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Bottom button bar: the background spans the full width and runs behind the navigation
         bar; UIUtils.applyBottomBarInsets adds the system insets to this padding. -->
    <style name="Widget.MakeACopy.BottomBar" parent="">
        <item name="android:background">?attr/colorSurfaceContainer</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <!-- Group heading in the options dialog (Scan / Camera / OCR / Export / App): a full-width
         row that expands or collapses its group; the chevron is set in code. -->
    <style name="Widget.MakeACopy.OptionsSection" parent="">
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Sub-group heading inside a group (PDF / JPEG / Inbox mode) -->
    <style name="Widget.MakeACopy.OptionsSubsection" parent="">
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <!-- Label above a radio group or spinner (Document cleanup, Page size, …) -->
    <style name="Widget.MakeACopy.OptionsLabel" parent="">
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">2dp</item>
    </style>

</resources>
